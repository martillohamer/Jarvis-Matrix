<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JARVIS Demo — Local Voice Agent</title>
<meta name="description" content="A free, multilingual, local-first AI chatbot and advanced voice agent for Windows. It replies out loud in your own language — English, Italian, Spanish, French, Portuguese, Hindi — running entirely on your machine. No account, no cloud.">
<meta property="og:title" content="JARVIS Demo — Local Voice Agent">
<meta property="og:description" content="A free, multilingual AI chatbot and advanced voice mode that runs entirely on your own computer. Speaks your language. No account, no cloud.">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="assets/styles.css">
<script type="module">
  import { JarvisAPI } from './assets/jarvis.js';
  import { VoiceManager } from './assets/voice-manager.js';
  
  const jarvis = new JarvisAPI();
  const voice = new VoiceManager();
  voice.setLanguage('es-ES');
  
  let consoleOpen = false;
  
  function createConsole() {
    const panel = document.createElement('div');
    panel.className = 'console-panel';
    panel.innerHTML = `
      <div class="console-header">
        <h3>JARVIS Console</h3>
        <div style="display:flex;gap:8px;align-items:center">
          <div class="state-indicator" id="api-status">
            <span class="state-dot offline"></span>
            <span>API</span>
          </div>
          <div class="state-indicator" id="voice-status">
            <span class="state-dot offline"></span>
            <span>Voice</span>
          </div>
          <button class="console-close" aria-label="Close console">&times;</button>
        </div>
      </div>
      <div class="console-messages" id="console-messages">
        <div class="msg system">Sistemas inicializados. Conectando a http://localhost:3001...</div>
      </div>
      <div class="console-input">
        <input type="text" id="console-input" placeholder="Message JARVIS..." autocomplete="off">
        <button id="console-send">Enviar</button>
        <button class="speaker-btn" id="voice-toggle" title="Toggle voice">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="23"></line><line x1="8" y1="23" x2="16" y2="23"></line></svg>
        </button>
      </div>
    `;
    document.body.appendChild(panel);
    return panel;
  }
  
  let apiOnline = false;
  
  let apiOnline = false;
  
  async function checkAPIStatus() {
    const status = document.getElementById('api-status');
    const dot = status?.querySelector('.state-dot');
    try {
      const ok = await jarvis.checkAvailability();
      if (ok && dot) {
        dot.className = 'state-dot online';
        status.querySelector('span:last-child').textContent = 'API Online';
        apiOnline = true;
      } else if (dot && !apiOnline) {
        dot.className = 'state-dot offline';
        status.querySelector('span:last-child').textContent = 'API Offline';
        addMessage('system', '✗ FreeLLMAPI no disponible. Inicia el servidor en puerto 3001');
      }
    } catch (e) {
      if (dot && !apiOnline) dot.className = 'state-dot offline';
    }
  }
  
  function normalizeName(name) {
    const lower = name.toLowerCase().trim();
    if (lower === 'yarbis' || lower === 'yervis') return 'jarvis';
    return lower;
  }
  
  function addMessage(role, content) {
    const container = document.getElementById('console-messages');
    if (!container) return;
    const msg = document.createElement('div');
    msg.className = `msg ${role}`;
    msg.textContent = content;
    container.appendChild(msg);
    container.scrollTop = container.scrollHeight;
  }
  
  async function sendMessage(text, fromVoice = false) {
    if (!text.trim()) return;
    addMessage('user', text);
    
    const thinkingMsg = document.createElement('div');
    thinkingMsg.className = 'msg thinking';
    thinkingMsg.textContent = 'Pensando...';
    const container = document.getElementById('console-messages');
    if (container) {
      container.appendChild(thinkingMsg);
      container.scrollTop = container.scrollHeight;
    }
    
    try {
      const response = await jarvis.chat(text);
      if (container && thinkingMsg.parentNode) {
        thinkingMsg.parentNode.removeChild(thinkingMsg);
      }
      addMessage('assistant', response);
      
      if (fromVoice) {
        voice.speak(response);
      } else {
        const voiceToggle = document.getElementById('voice-toggle');
        if (voiceToggle?.classList.contains('active')) {
          voice.speak(response);
        }
      }
      
      const input = panel.querySelector('#console-input');
      if (input) input.value = '';
    } catch (e) {
      if (container && thinkingMsg.parentNode) {
        thinkingMsg.parentNode.removeChild(thinkingMsg);
      }
      addMessage('system', `Error: ${e.message}`);
    }
  }
  
  // Voice state handlers
  voice.on('onStart', () => {
    const dot = document.getElementById('voice-status')?.querySelector('.state-dot');
    const sphere = document.getElementById('voice-sphere');
    if (dot) dot.className = 'state-dot listening';
    if (sphere) sphere.classList.add('listening');
  });
  
  voice.on('onEnd', () => {
    const dot = document.getElementById('voice-status')?.querySelector('.state-dot');
    const sphere = document.getElementById('voice-sphere');
    if (dot) dot.className = 'state-dot online';
    if (sphere) sphere.classList.remove('listening');
  });
  
  voice.on('onSynthesisStart', () => {
    const dot = document.getElementById('voice-status')?.querySelector('.state-dot');
    const sphere = document.getElementById('voice-sphere');
    if (dot) dot.className = 'state-dot speaking';
    if (sphere) sphere.classList.add('speaking');
  });
  
  voice.on('onSynthesisEnd', () => {
    const dot = document.getElementById('voice-status')?.querySelector('.state-dot');
    const sphere = document.getElementById('voice-sphere');
    if (dot) dot.className = 'state-dot online';
    if (sphere) sphere.classList.remove('speaking');
  });
  
  voice.on('onError', (err) => {
    const dot = document.getElementById('voice-status')?.querySelector('.state-dot');
    const sphere = document.getElementById('voice-sphere');
    if (dot) dot.className = 'state-dot offline';
    if (sphere) sphere.classList.remove('listening', 'speaking');
    addMessage('system', `Voice error: ${err.message}`);
  });
  
  // Initialize on DOM ready
  document.addEventListener('DOMContentLoaded', () => {
    const panel = createConsole();
    checkAPIStatus();
    
    // Voice sphere
    const sphere = document.getElementById('voice-sphere');
    sphere?.addEventListener('click', () => {
      if (sphere.classList.contains('listening')) {
        voice.stopListening();
      } else {
        voice.listen((transcript) => {
          const input = panel.querySelector('#console-input');
          if (input) input.value = transcript;
          sendMessage(transcript, true);
        });
      }
    });
    
    // Open console from hero button
    document.querySelector('.btn-primary')?.addEventListener('click', (e) => {
      e.preventDefault();
      panel.style.display = 'flex';
      consoleOpen = true;
    });
    
    // Close console
    panel.querySelector('.console-close')?.addEventListener('click', () => {
      panel.style.display = 'none';
      consoleOpen = false;
    });
    
    // Send message
    const input = panel.querySelector('#console-input');
    const sendBtn = panel.querySelector('#console-send');
    const send = () => {
      const text = input.value.trim();
      if (text) {
        sendMessage(text, false);
        input.value = '';
      }
    };
    
    sendBtn?.addEventListener('click', send);
    input?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') send();
    });
    
    // Voice toggle
    const voiceToggle = panel.querySelector('#voice-toggle');
    voiceToggle?.addEventListener('click', () => {
      voiceToggle.classList.toggle('active');
    });
    
    // Periodic health check
    setInterval(checkAPIStatus, 30000);
  });
</script>
</head>
<body>

<header class="nav">
  <div class="wrap nav-in">
    <div class="brand">J<b>.</b>A<b>.</b>R<b>.</b>V<b>.</b>I<b>.</b>S<b>.</b> <span style="color:var(--faint)">DEMO</span></div>
    <nav class="nav-links">
      <a href="#features">Features</a>
      <a href="#how">How it works</a>
      <a href="#requirements">Requirements</a>
      <a href="https://github.com/Ale-Studios/JARVIS-Demo">GitHub</a>
    </nav>
  </div>
</header>

<main>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Free · Unlimited · 100% local</p>
      <h1>An AI that <span class="grad">speaks your language</span>,<br>running on your machine</h1>
      <p class="lede">A free chatbot and advanced voice mode for Windows. Write or speak in your
        language — Jarvis replies in text and out loud, in that same language, with a native
        voice and his trademark dry wit. No account, no API key, no cloud, no telemetry.</p>
      <div class="cta">
        <button class="btn btn-primary">⚡ Open Console</button>
        <a class="btn btn-ghost" href="#how">How it works</a>
      </div>
      <p class="cta-note">Windows 10 / 11 · installer · requires the free <a href="https://ollama.com" style="color:var(--blue-2)">Ollama</a> engine</p>
      <div class="langs">
        <span class="lang">🇬🇧 English</span>
        <span class="lang">🇮🇹 Italiano</span>
        <span class="lang">🇪🇸 Español</span>
        <span class="lang">🇫🇷 Français</span>
        <span class="lang">🇧🇷 Português</span>
        <span class="lang">🇮🇳 हिन्दी</span>
      </div>
    </div>
  </section>

  <section class="demo" aria-label="Demo video">
    <div class="wrap">
      <figure class="shot">
        <video controls preload="metadata" playsinline poster="docs/screenshots/voice.png">
          <source src="docs/media/JARVIS-Presentation-4K.mp4" type="video/mp4">
          Your browser cannot play embedded video. <a href="docs/media/JARVIS-Presentation-4K.mp4">Download the demo video</a>.
        </video>
        <figcaption><b>Watch the demo</b> — JARVIS in action.</figcaption>
      </figure>
    </div>
  </section>

  <section class="shots" aria-label="Screenshots">
    <div class="wrap shots-grid">
      <figure class="shot">
        <img src="docs/screenshots/chat.png" alt="JARVIS chat interface with the neural core and a streamed reply" loading="lazy" width="2560" height="1600">
        <figcaption><b>Chat</b> — streamed replies from a local model, in your language.</figcaption>
      </figure>
      <figure class="shot">
        <img src="docs/screenshots/voice.png" alt="JARVIS advanced voice mode: a full-screen reactive particle sphere" loading="lazy" width="2560" height="1600">
        <figcaption><b>Advanced voice mode</b> — a full-screen sphere with neural turn detection.</figcaption>
      </figure>
    </div>
  </section>

  <section id="features">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">What's inside</p>
        <h2>Chat and advanced voice — in your language</h2>
        <p>This demo keeps two things from the full Jarvis assistant: the chat and the advanced voice mode. Nothing else, nothing to pay.</p>
      </div>
      <div class="features">
        <div class="card"><div class="ic">🌍</div><h3>Speaks your language</h3><p>Write in English, Italian, Spanish, French, Portuguese or Hindi — Jarvis detects it and replies out loud in that language, with a native voice. Fully local, no cloud translation.</p></div>
        <div class="card"><div class="ic">💬</div><h3>Local chat</h3><p>A local language model via Ollama, streamed word by word as he replies.</p></div>
        <div class="card"><div class="ic">🎙️</div><h3>Advanced voice mode</h3><p>A hands-free particle sphere with neural turn detection. Hold Space or tap the mic; he listens, thinks, and speaks back.</p></div>
        <div class="card"><div class="ic">🎩</div><h3>Dry British wit</h3><p>A razor-witted butler with a deadpan sense of humour — the same character in every language.</p></div>
        <div class="card"><div class="ic">🔊</div><h3>Five English voices</h3><p>Pick the English voice you like; other languages use their own native voice automatically.</p></div>
        <div class="card"><div class="ic">🔒</div><h3>Private by design</h3><p>No accounts, no API keys, no telemetry. Your conversations and your voice stay on your computer.</p></div>
      </div>
    </div>
  </section>

  <section id="how" style="background:var(--bg-2)">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Get started in minutes</p>
        <h2>Three steps to talking with Jarvis</h2>
      </div>
      <div class="steps">
        <div class="step"><h3>Install Ollama</h3><p>Install the free local AI engine from <a href="https://ollama.com" style="color:var(--blue-2)">ollama.com</a>, then pull the model once: <code>ollama pull qwen2.5:3b</code></p></div>
        <div class="step"><h3>Download Jarvis</h3><p>Grab <code>JARVIS-Voice-Agent-Setup.exe</code> from the releases page. The installer is per-user — no admin rights needed.</p></div>
        <div class="step"><h3>Run & talk</h3><p>Launch Jarvis from the Start menu. Type in any supported language, or open voice mode and hold Space to speak.</p></div>
      </div>
      <div style="text-align:center;margin-top:34px">
        <a class="btn btn-ghost" href="https://github.com/Ale-Studios/JARVIS-Demo/blob/master/WELCOME.md">📖 Read the beginner guide</a>
      </div>
    </div>
  </section>

  <section id="requirements">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Before you install</p>
        <h2>System requirements</h2>
        <p>Jarvis runs the AI and the voice on your own machine, so the experience depends on your PC. These are realistic minimums for the bundled model.</p>
      </div>
      <div class="reqs">
        <table>
          <thead><tr><th></th><th>Minimum</th><th>Recommended</th></tr></thead>
          <tbody>
            <tr><td>OS</td><td>Windows 10 / 11, 64-bit</td><td class="rec">Windows 11, 64-bit</td></tr>
            <tr><td>CPU</td><td>Any modern 64-bit (x64)</td><td class="rec">Recent multi-core</td></tr>
            <tr><td>RAM</td><td>8 GB</td><td class="rec">16 GB</td></tr>
            <tr><td>Free disk</td><td>~4 GB</td><td class="rec">6 GB+</td></tr>
            <tr><td>GPU</td><td>None (runs on CPU)</td><td class="rec">WebGPU-capable (NVIDIA / AMD / Intel)</td></tr>
            <tr><td>Internet</td><td>Setup only</td><td class="rec">Offline after setup</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="privacy">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Local. Private. Yours.</p>
        <h2>Nothing you say leaves your computer</h2>
        <ul>
          <li>No accounts</li>
          <li>No API keys</li>
          <li>No cloud</li>
          <li>No telemetry</li>
          <li>No auto-update</li>
        </ul>
        <p style="color:var(--muted);margin-top:22px">The model runs locally through Ollama and the voice runs on-device. The only network use is the one-time model downloads and your own prompts going to Ollama on your machine.</p>
      </div>
    </div>
  </section>

  <section class="final">
    <div class="wrap">
      <h2>Ready to meet Jarvis?</h2>
      <p>Free, unlimited, multilingual, and entirely yours. Download it, run it, and start talking.</p>
      <div class="cta">
        <a class="btn btn-primary" href="https://github.com/Ale-Studios/JARVIS-Demo/releases/latest">⬇ Download for Windows</a>
        <a class="btn btn-ghost" href="https://github.com/Ale-Studios/JARVIS-Demo">View on GitHub</a>
      </div>
    </div>
  </section>
</main>

<footer>
  <div class="wrap foot-in">
    <div>
      <div class="brand" style="margin-bottom:8px">J<b>.</b>A<b>.</b>R<b>.</b>V<b>.</b>I<b>.</b>S<b>.</b> Demo</div>
      <p class="foot-note">A free taste of the larger Jarvis desktop assistant — a separate, proprietary application.</p>
    </div>
    <div class="foot-links">
      <a href="https://github.com/Ale-Studios/JARVIS-Demo#readme">Overview</a>
      <a href="https://github.com/Ale-Studios/JARVIS-Demo/blob/master/WELCOME.md">Guide</a>
      <a href="https://github.com/Ale-Studios/JARVIS-Demo/releases/latest">Download</a>
      <a href="https://github.com/Ale-Studios/JARVIS-Demo/blob/master/LICENSE">License (MIT)</a>
    </div>
  </div>
</footer>

<!-- Voice Sphere -->
<div id="voice-sphere" class="voice-sphere" title="Activar voz (Español)" aria-label="Voice activation">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
    <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
    <line x1="12" y1="19" x2="12" y2="23"></line>
    <line x1="8" y1="23" x2="16" y2="23"></line>
  </svg>
</div>

</body>
</html>